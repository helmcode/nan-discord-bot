# Discord bot credentials
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# LiteLLM API for LLM and embeddings
LITELLM_BASE_URL=https://api.nan.builders/v1
LITELLM_API_KEY=

# LiteLLM admin endpoints (optional, only needed for /metrics)
# LITELLM_PROXY_URL points at the LiteLLM admin API; LITELLM_ADMIN_KEY is the admin key.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_ADMIN_KEY=

# Knowledge base settings
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIM=4096
TOP_K=5

# Bot will only respond when mentioned in these channels (comma-separated IDs).
# Leave empty to respond in any channel.
ALLOWED_CHANNELS=

# Daily metrics report (optional). If STATUS_CHANNEL_ID is empty the report is disabled.
STATUS_CHANNEL_ID=
METRICS_SEND_HOUR=9

# Docs remote sync
DOCS_BASE_URL=https://nan.builders
DOCS_REFRESH_INTERVAL=900
DOCS_USE_REMOTE=local
DOCS_CACHE_DIR=vector_db/docs_cache
DOCS_HTTP_TIMEOUT=10
